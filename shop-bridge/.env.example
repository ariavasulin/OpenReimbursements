# Copy to .env and fill in. On the bridge box, install/setup.ps1 writes C:\dws-bridge\.env for you.
# Never commit a real .env.

# SQL Server to read from: HOST\INSTANCE (named instance), host,port, or a plain host.
SHOP_DB_SERVER='SQL2016\SQLEXPRESS'
# Database name on that server.
SHOP_DB_NAME=DWS
# Read-only login (db_datareader + db_denydatawriter). With SHOP_DB_DOMAIN set, this is the Windows user name.
SHOP_DB_USER=dws_bridge_ro
# Password for that login.
SHOP_DB_PASSWORD=change-me
# Optional: Windows domain. Set it only when the login is a Windows account (NTLM); leave unset for a SQL login.
# SHOP_DB_DOMAIN=DWS
# Accept the SQL Server's self-signed certificate on the shop LAN (true/false). Default true.
SHOP_DB_TRUST_CERT=true

# Bearer token callers must send on /query and /ddl. At least 32 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHOP_BRIDGE_TOKEN=change-me-to-64-hex-characters
# Port on 127.0.0.1 that the bridge listens on (cloudflared points here). Default 8787.
SHOP_BRIDGE_PORT=8787

# Supabase session pooler URL for the shop_mirror role (port 5432). Leave unset to turn the mirror off.
# SHOP_MIRROR_DATABASE_URL=postgresql://shop_mirror.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Minutes between mirror runs. Default 15.
SHOP_MIRROR_INTERVAL_MINUTES=15
