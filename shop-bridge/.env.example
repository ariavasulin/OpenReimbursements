# Copy to .env and fill in. On the shop computer, install/setup.ps1 writes C:\dws-bridge\.env for you.
# Never commit a real .env. What each setting means, and its default: README.md § 9 Reference, Settings.

SHOP_DB_SERVER='SQL2016\SQLEXPRESS'
SHOP_DB_NAME=DWS
SHOP_DB_USER=dws_bridge_ro
SHOP_DB_PASSWORD=change-me
# SHOP_DB_DOMAIN=DWS
SHOP_DB_TRUST_CERT=true

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHOP_BRIDGE_TOKEN=change-me-to-64-hex-characters
SHOP_BRIDGE_PORT=8787

# The mirror calls Supabase's HTTPS API. Unset URL = mirror off.
# SHOP_MIRROR_SUPABASE_URL=https://<project-ref>.supabase.co
# The project's public anon (or publishable) key.
# SHOP_MIRROR_API_KEY=
# The shop computer's mirror token; Supabase keeps only its SHA-256 (shop.mirror_token). Generate as above.
# SHOP_MIRROR_TOKEN=change-me-to-64-hex-characters
SHOP_MIRROR_INTERVAL_MINUTES=15
# SHOP_MIRROR_MAX_ROWS=100000

# SHOP_QUERIES_FILE=C:\dws-bridge\queries.json
